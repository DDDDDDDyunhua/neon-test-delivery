          "curl",
          "-fsS",
          "http://127.0.0.1:8080/health"
        ],
        "interval": "3s",
        "timeout": "3s",
        "retries": 30
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    }
  },
  "networks": {
    "cluster": {
      "name": "neon-cluster-net",
      "driver": "bridge"
    }
  }
}