{
  "name": "neoncluster",
  "services": {
    "broker": {
      "image": "neon-kernel:20261026",
      "container_name": "neon-cluster-broker",
      "hostname": "broker",
      "restart": "unless-stopped",
      "user": "1000:1000",
      "entrypoint": [
        "/bin/bash",
        "/configs/start.sh",
        "broker"
      ],
      "volumes": [
        "./configs:/configs:ro",
        "./data/broker:/data"
      ],
      "environment": {
        "RUST_LOG": "info",
        "SSL_CERT_FILE": "/configs/ca-bundle.crt"
      },
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "stop_grace_period": "60s",
      "mem_limit": "1g",
      "networks": [
        "cluster"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "control-db": {
      "image": "neon-kernel:20261026",
      "container_name": "neon-cluster-control-db",
      "hostname": "control-db",
      "restart": "unless-stopped",
      "user": "1000:1000",
      "entrypoint": [
        "/bin/bash",
        "/configs/start.sh",
        "control-db"
      ],
      "volumes": [
        "./configs:/configs:ro",
        "./data/control-db:/data"
      ],
      "environment": {
        "RUST_LOG": "info",
        "SSL_CERT_FILE": "/configs/ca-bundle.crt"
      },
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "stop_grace_period": "60s",
      "mem_limit": "1g",
      "networks": [
        "cluster"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "/opt/neon-kernel/pg_install/v17/bin/pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "neon",
          "-d",
          "storage_controller"
        ],
        "interval": "3s",
        "timeout": "3s",
        "retries": 30
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "controller": {
      "image": "neon-kernel:20261026",
      "container_name": "neon-cluster-controller",
      "hostname": "controller",
      "restart": "unless-stopped",
      "user": "1000:1000",
      "entrypoint": [
        "/bin/bash",
        "/configs/start.sh",
        "controller"
      ],
      "volumes": [
        "./configs:/configs:ro",
        "./data/controller:/data"
      ],
      "environment": {
        "RUST_LOG": "info",
        "SSL_CERT_FILE": "/configs/ca-bundle.crt"
      },
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "stop_grace_period": "60s",
      "mem_limit": "1g",
      "networks": [
        "cluster"
      ],
      "ports": [
        "127.0.0.1:2234:1234"
      ],
      "depends_on": {
        "control-db": {
          "condition": "service_healthy"
        },
        "compute-hook": {
          "condition": "service_healthy"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-fsS",
          "http://127.0.0.1:1234/ready"
        ],
        "interval": "3s",
        "timeout": "3s",
        "retries": 40
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "ps1": {
      "image": "neon-kernel:20261026",
      "container_name": "neon-cluster-ps1",
      "hostname": "ps1",
      "restart": "unless-stopped",
      "user": "1000:1000",
      "entrypoint": [
        "/bin/bash",
        "/configs/start.sh",
        "ps1"
      ],
      "volumes": [
        "./configs:/configs:ro",
        "./data/ps1:/data",
        "./data/shared:/shared"
      ],
      "environment": {
        "RUST_LOG": "info",
        "SSL_CERT_FILE": "/configs/ca-bundle.crt"
      },
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "stop_grace_period": "60s",
      "mem_limit": "2g",
      "networks": [
        "cluster"
      ],
      "ports": [
        "127.0.0.1:21981:9898"
      ],
      "depends_on": {
        "controller": {
          "condition": "service_started"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-fsS",
          "http://127.0.0.1:9898/v1/status"
        ],
        "interval": "3s",
        "timeout": "3s",
        "retries": 40
      },
      "runtime": "neon-runc",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "ps2": {
      "image": "neon-kernel:20261026",
      "container_name": "neon-cluster-ps2",
      "hostname": "ps2",
      "restart": "unless-stopped",
      "user": "1000:1000",
      "entrypoint": [
        "/bin/bash",
        "/configs/start.sh",
        "ps2"
      ],
      "volumes": [
        "./configs:/configs:ro",
        "./data/ps2:/data",
        "./data/shared:/shared"
      ],
      "environment": {
        "RUST_LOG": "info",
        "SSL_CERT_FILE": "/configs/ca-bundle.crt"
      },
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "stop_grace_period": "60s",
      "mem_limit": "2g",
      "networks": [
        "cluster"
      ],
      "ports": [
        "127.0.0.1:21982:9898"
      ],
      "depends_on": {
        "controller": {
          "condition": "service_started"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-fsS",
          "http://127.0.0.1:9898/v1/status"
        ],
        "interval": "3s",
        "timeout": "3s",
        "retries": 40
      },
      "runtime": "neon-runc",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "sk1": {
      "image": "neon-kernel:20261026",
      "container_name": "neon-cluster-sk1",
      "hostname": "sk1",
      "restart": "unless-stopped",
      "user": "1000:1000",
      "entrypoint": [
        "/bin/bash",
        "/configs/start.sh",
        "sk1"
      ],
      "volumes": [
        "./configs:/configs:ro",
        "./data/sk1:/data"
      ],
      "environment": {
        "RUST_LOG": "info",
        "SSL_CERT_FILE": "/configs/ca-bundle.crt"
      },
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "stop_grace_period": "60s",
      "mem_limit": "1g",
      "networks": [
        "cluster"
      ],
      "ports": [
        "127.0.0.1:27671:7676"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "sk2": {
      "image": "neon-kernel:20261026",
      "container_name": "neon-cluster-sk2",
      "hostname": "sk2",
      "restart": "unless-stopped",
      "user": "1000:1000",
      "entrypoint": [
        "/bin/bash",
        "/configs/start.sh",
        "sk2"
      ],
      "volumes": [
        "./configs:/configs:ro",
        "./data/sk2:/data"
      ],
      "environment": {
        "RUST_LOG": "info",
        "SSL_CERT_FILE": "/configs/ca-bundle.crt"
      },
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "stop_grace_period": "60s",
      "mem_limit": "1g",
      "networks": [
        "cluster"
      ],
      "ports": [
        "127.0.0.1:27672:7676"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "sk3": {
      "image": "neon-kernel:20261026",
      "container_name": "neon-cluster-sk3",
      "hostname": "sk3",
      "restart": "unless-stopped",
      "user": "1000:1000",
      "entrypoint": [
        "/bin/bash",
        "/configs/start.sh",
        "sk3"
      ],
      "volumes": [
        "./configs:/configs:ro",
        "./data/sk3:/data"
      ],
      "environment": {
        "RUST_LOG": "info",
        "SSL_CERT_FILE": "/configs/ca-bundle.crt"
      },
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "stop_grace_period": "60s",
      "mem_limit": "1g",
      "networks": [
        "cluster"
      ],
      "ports": [
        "127.0.0.1:27673:7676"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "compute16": {
      "image": "neon-kernel:20261026",
      "container_name": "neon-cluster-compute16",
      "hostname": "compute16",
      "restart": "unless-stopped",
      "user": "1000:1000",
      "entrypoint": [
        "/bin/bash",
        "/configs/start.sh",
        "compute16"
      ],
      "volumes": [
        "./configs:/configs:ro",
        "./data/compute16:/data"
      ],
      "environment": {
        "RUST_LOG": "info",
        "SSL_CERT_FILE": "/configs/ca-bundle.crt"
      },
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "stop_grace_period": "60s",
      "mem_limit": "1g",
      "networks": [
        "cluster"
      ],
      "ports": [
        "127.0.0.1:56432:5432"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "/opt/neon-kernel/pg_install/v16/bin/pg_isready",
          "-h",
          "127.0.0.1",
          "-p",
          "5432",
          "-U",
          "cloud_admin"
        ],
        "interval": "3s",
        "timeout": "3s",
        "retries": 40
      },
      "shm_size": "256m",
      "depends_on": {
        "ps1": {
          "condition": "service_healthy"
        },
        "ps2": {
          "condition": "service_healthy"
        },
        "sk1": {
          "condition": "service_started"
        },
        "sk2": {
          "condition": "service_started"
        },
        "sk3": {
          "condition": "service_started"
        }
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "compute17": {
      "image": "neon-kernel:20261026",
      "container_name": "neon-cluster-compute17",
      "hostname": "compute17",
      "restart": "unless-stopped",
      "user": "1000:1000",
      "entrypoint": [
        "/bin/bash",
        "/configs/start.sh",
        "compute17"
      ],
      "volumes": [
        "./configs:/configs:ro",
        "./data/compute17:/data"
      ],
      "environment": {
        "RUST_LOG": "info",
        "SSL_CERT_FILE": "/configs/ca-bundle.crt"
      },
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "stop_grace_period": "60s",
      "mem_limit": "1g",
      "networks": [
        "cluster"
      ],
      "ports": [
        "127.0.0.1:57432:5432"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "/opt/neon-kernel/pg_install/v17/bin/pg_isready",
          "-h",
          "127.0.0.1",
          "-p",
          "5432",
          "-U",
          "cloud_admin"
        ],
        "interval": "3s",
        "timeout": "3s",
        "retries": 40
      },
      "shm_size": "256m",
      "depends_on": {
        "ps1": {
          "condition": "service_healthy"
        },
        "ps2": {
          "condition": "service_healthy"
        },
        "sk1": {
          "condition": "service_started"
        },
        "sk2": {
          "condition": "service_started"
        },
        "sk3": {
          "condition": "service_started"
        }
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
