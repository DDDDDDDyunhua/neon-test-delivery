    "compute-hook": {
      "image": "neon-kernel:20261026",
      "container_name": "neon-cluster-compute-hook",
      "hostname": "compute-hook",
      "restart": "unless-stopped",
      "user": "1000:1000",
      "entrypoint": [
        "/usr/bin/python3",
        "/configs/hook.py"
      ],
      "volumes": [
        "./configs:/configs",
        "./data/compute-hook:/data",
        "./secrets:/secrets:ro"
      ],
      "environment": {
        "RUST_LOG": "info",
        "SSL_CERT_FILE": "/configs/ca-bundle.crt"
      },
      "security_opt": [
